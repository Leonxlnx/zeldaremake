{
  "name": "zeldaremake",
  "version": "0.1.0",
  "description": "Kokiri Forest (Ocarina of Time remake reference) recreated as a real-time Three.js world. Phase 1: world only.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "ref:extract": "node gauntlet/scripts/ref-extract.mjs",
    "capture": "node gauntlet/scripts/capture.mjs",
    "compare": "node gauntlet/scripts/compare.mjs",
    "score": "node gauntlet/scripts/score.mjs",
    "anticheat": "node gauntlet/scripts/anti-cheat.mjs",
    "gauntlet": "node gauntlet/scripts/gauntlet.mjs",
    "gauntlet:verify-exit": "node gauntlet/scripts/gauntlet.mjs --verify-exit",
    "take": "node gauntlet/scripts/take.mjs",
    "site:dev": "node site/serve.mjs",
    "site:build": "node site/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonxlnx/zeldaremake.git"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.4",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
